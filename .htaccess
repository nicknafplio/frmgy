RewriteEngine On

# Strip www and force https (skipped for localhost).
# X-Forwarded-Proto is checked too, so this doesn't loop behind a proxy/CDN (e.g. Cloudflare) that terminates https.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redirect direct requests for page.html to the clean URL.
# Uses the host from the request, so it works at domain root or in a subfolder on any hostname.
RewriteCond %{THE_REQUEST} \s(\S+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L,NE]

# Serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html
