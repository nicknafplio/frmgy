RewriteEngine On

# Strip www (https itself is forced by Cloudflare, "Always Use HTTPS"; doing it here loops behind Cloudflare).
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect direct requests for page.html to the clean URL.
# Uses the host from the request, so it works at domain root or in a subfolder on any hostname.
RewriteCond %{THE_REQUEST} \s(\S+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L,NE]

# Serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html
